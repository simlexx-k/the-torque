# X API: read-only public-data access only needs the Bearer Token.
X_BEARER_TOKEN=
# Preferred: comma-separated accounts. Existing deployments may keep using the
# singular X_TARGET_USERNAME setting; X_TARGET_USERNAMES takes precedence.
X_TARGET_USERNAMES=
X_TARGET_USERNAME=
X_EXCLUDE_REPLIES=false
X_EXCLUDE_RETWEETS=true
# Backwards-compatible pagination preference for initial timeline retrieval.
# Incremental polls exhaust the available User Posts pagination window before
# advancing a source cursor so a large burst cannot create a silent data gap.
X_MAX_PAGES_PER_POLL=5
# Total recent posts to backfill when an account is first added. The current X
# User Posts timeline exposes up to 3,200 recent posts. The adapter automatically
# requests enough pages for this target, up to that timeline limit.
INITIAL_LOOKBACK_POSTS=500

# Multimodal vehicle enrichment.
# Gemini is the default provider and does not require OpenAI credits.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_MAX_IMAGES=6
AI_RETRY_BATCH_SIZE=10
AI_RETRY_MAX_ATTEMPTS=5

# Optional backwards-compatible OpenAI provider. Only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_DETAIL=auto

# Runtime / persistence.
ADMIN_API_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://thetorque:change-me@db:5432/thetorque
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Nairobi
DAYTIME_START_HOUR=6
DAYTIME_END_HOUR=22
DAYTIME_POLL_SECONDS=600
NIGHTTIME_POLL_SECONDS=3600

# Remotely managed Cloudflare Tunnel.
# Obtain this from Cloudflare after creating/rotating the tunnel token.
# Never commit the real value; .env is ignored by Git.
CLOUDFLARED_TOKEN=

# Network hardening for the VPS / Cloudflare Tunnel deployment.
# With the Vercel server-side proxy, browser CORS can normally remain empty.
CORS_ALLOWED_ORIGINS=
# Production example for the current API hostname:
# torque-api.a3slabs.co.ke,127.0.0.1,localhost
TRUSTED_HOSTS=*
# Keep FastAPI Swagger/ReDoc/OpenAPI discovery disabled on the public hostname.
API_DOCS_ENABLED=false
