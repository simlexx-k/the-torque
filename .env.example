# X API: read-only public-data access only needs the Bearer Token.
X_BEARER_TOKEN=
X_TARGET_USERNAME=
X_EXCLUDE_REPLIES=false
X_EXCLUDE_RETWEETS=true
X_MAX_PAGES_PER_POLL=5
INITIAL_LOOKBACK_POSTS=100

# OpenAI multimodal structured extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_DETAIL=auto

# Runtime / persistence.
ADMIN_API_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://thetorque:change-me@db:5432/thetorque
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Nairobi
DAYTIME_START_HOUR=6
DAYTIME_END_HOUR=22
DAYTIME_POLL_SECONDS=600
NIGHTTIME_POLL_SECONDS=3600

# Remotely managed Cloudflare Tunnel.
# Obtain this from Cloudflare after creating/rotating the tunnel token.
# Never commit the real value; .env is ignored by Git.
CLOUDFLARED_TOKEN=

# Network hardening for the VPS / Cloudflare Tunnel deployment.
# With the Vercel server-side proxy, browser CORS can normally remain empty.
CORS_ALLOWED_ORIGINS=
# Production example for the current API hostname:
# torque-api.a3slabs.co.ke,127.0.0.1,localhost
TRUSTED_HOSTS=*
