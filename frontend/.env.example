# Server-side only. In Vercel, set this to the HTTPS hostname published by Cloudflare Tunnel.
# Example: https://api.example.com
TORQUE_API_BASE_URL=http://127.0.0.1:8000

# Optional: if the Cloudflare API hostname is protected by Access Service Auth,
# store the service token pair as encrypted Vercel environment variables.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Keep false/omitted for the public site. When false, /system, /signals and the
# corresponding status/posts/overview proxy routes return 404 in production.
# Only enable behind a separate authenticated operator deployment.
TORQUE_PUBLIC_OPERATOR_ROUTES=false

# Rolling-deploy compatibility switch. Leave true only until the VPS backend
# containing public_id support has been deployed and existing listings have
# been backfilled. Then set false in Vercel and redeploy to reject enumerable
# /api/torque/listings/70-style requests at the public proxy.
TORQUE_ALLOW_LEGACY_PUBLIC_IDS=true
